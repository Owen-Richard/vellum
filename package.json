{
  "name": "vellum-edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser",
    "package": "npm run build && node scripts/package.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "bippy": "^0.5.39",
    "clsx": "^2.1.1",
    "lucide-react": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "specificity": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
